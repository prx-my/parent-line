---
import { alarmMarks, alarmSteps, jobs } from "../content";
const steps = JSON.stringify(alarmSteps.map(({ clock, caption, jobs }) => ({ clock, caption, jobs })));
---
<section class="alarm-sec" id="alarm" data-alarm data-steps={steps}>
  <div class="wrap inner">
    <div class="grid head">
      <h2 class="h2 c-l6">One alarm, start to finish</h2>
      <p class="lead c-r">The Guardian splits the response into three jobs, tracks who has each, chases the ones nobody took, and hands the paperwork to the Clerk.</p>
    </div>

    <div class="grid stage after-head">
      <div class="side c-l" aria-hidden="true">
        <div class="clock num" data-clock><span>{alarmSteps[0].clock}</span></div>
        <p class="lead cap" data-cap>{alarmSteps[0].caption}</p>

        <div class="rail" data-rail>
          <span class="rail-line"></span>
          <span class="rail-fill" data-rail-fill></span>
          {alarmMarks.map((m, i) => (
            <span class="rail-tick" data-rail-tick style={`--p:${(i / (alarmMarks.length - 1)) * 100}%`}><i></i><em>{m}</em></span>
          ))}
        </div>

        <ol class="jobs">
          {jobs.map((job, i) => (
            <li data-job data-s="idle">
              <span class="meta">{i + 1}</span><span class="job">{job}</span><span class="state meta">waiting</span>
            </li>
          ))}
        </ol>
        <p class="meta case" data-case>Case file: case-2026-11-06-sbi-480000</p>
      </div>

      <div class="feed c-r" data-feed>
        <ol class="t" data-feed-list>
          {alarmSteps.map((s) => (
            <li data-msg>
              <time>{s.time}</time>
              <span class="from">{s.from}<small>{s.kind}</small></span>
              <div class="body" set:html={s.html} />
            </li>
          ))}
        </ol>
      </div>
    </div>
    <p class="note after-item">Times from a live test in a Telegram group. The bank SMS was simulated with <code>bankwatch simulate</code>, which runs the same parser and rules as a forwarded SMS. A false alarm costs one reply: "it's fine, she's buying the flat."</p>
  </div>
</section>

<style>
  .side { display: none; }
  .after-item { margin-top: 32px; }

  /* Pinned layout, switched on by the motion script on wide screens */
  .alarm-sec.is-pinned { height: 100vh; height: 100svh; padding-block: calc(64px + 40px) 32px; }
  .alarm-sec.is-pinned .inner { height: 100%; display: flex; flex-direction: column; }
  .alarm-sec.is-pinned .stage { flex: 1; min-height: 0; margin-top: 48px; }
  .alarm-sec.is-pinned .side { display: flex; flex-direction: column; min-height: 0; }
  .alarm-sec.is-pinned .feed { position: relative; height: 100%; overflow: hidden; -webkit-mask-image: linear-gradient(transparent, #000 16%); mask-image: linear-gradient(transparent, #000 16%); }
  .alarm-sec.is-pinned .t { position: absolute; left: 0; right: 0; top: 0; border-top: 0; }
  .alarm-sec.is-pinned .t > li { grid-template-columns: 8.5rem minmax(0, 1fr); }
  .alarm-sec.is-pinned .t time { display: none; }
  .alarm-sec.is-pinned [data-msg] { opacity: 0; transform: translateY(24px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
  .alarm-sec.is-pinned [data-msg].on { opacity: 0.36; transform: none; }
  .alarm-sec.is-pinned [data-msg].now { opacity: 1; }
  .alarm-sec.is-pinned .after-item { margin-top: 20px; }

  .clock { font-size: clamp(5rem, 10.5vw, 9.5rem); color: var(--stamp); transition: color 0.5s; }
  .clock.closed { color: var(--ink); }
  .clock span { display: inline-block; }
  .cap { margin-top: 16px; min-height: 1.6em; }

  .rail { position: relative; height: 40px; margin-top: 28px; margin-inline: 4px; }
  .rail-line, .rail-fill { position: absolute; left: 0; right: 0; top: 4px; height: 1px; background: var(--rule-strong); }
  .rail-fill { background: var(--stamp); height: 2px; top: 3.5px; transform-origin: left; transform: scaleX(0); }
  .rail-tick { position: absolute; left: var(--p); top: 0; transform: translateX(-50%); display: grid; justify-items: center; gap: 8px; }
  .rail-tick i { width: 9px; height: 9px; background: var(--paper); border: 1.5px solid var(--rule-strong); transition: background-color 0.3s, border-color 0.3s, transform 0.3s; }
  .rail-tick em { font: 400 0.6875rem/1 var(--mono); font-style: normal; color: var(--ink-soft); white-space: nowrap; }
  .rail-tick.past i { background: var(--stamp); border-color: var(--stamp); }
  .rail-tick.now i { transform: scale(1.5); }
  .closed ~ .rail .rail-tick.past i { background: var(--ink); border-color: var(--ink); }

  .jobs { list-style: none; margin: auto 0 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .jobs li { display: grid; grid-template-columns: 2rem minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding-block: 13px; border-bottom: 1px solid var(--rule); }
  .job { font-size: var(--fs-h4); font-stretch: 85%; font-weight: 560; text-decoration: line-through; text-decoration-color: transparent; text-decoration-thickness: 1.5px; transition: text-decoration-color 0.4s, color 0.4s; }
  .state { transition: color 0.4s; }
  [data-s="none"] .state { color: var(--stamp); }
  [data-s="wait"] .state { color: var(--ink); }
  [data-s="done"] .job { text-decoration-color: var(--ink); color: var(--ink-soft); }
  .case { margin-top: 14px; opacity: 0; transition: opacity 0.5s; }
  .case.on { opacity: 1; }
</style>
