---
import { repo } from "../content";
---
<header class="nav" data-nav>
  <div class="wrap bar">
    <a class="mark" href="#top">Parent Line</a>
    <nav aria-label="Sections">
      <a href="#alarm">The alarm</a>
      <a href="#room">On Switch</a>
      <a href="#run">Try it</a>
      <a href="/blog/">Blog</a>
      <a href={repo}>GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 20;
    padding-top: env(safe-area-inset-top, 0px);
    background: var(--paper); border-bottom: 1px solid var(--rule);
    transition: transform 0.5s var(--ease);
  }
  .nav.hide { transform: translateY(-100%); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; height: 64px; }
  .mark { font-weight: 650; font-size: 1.3125rem; font-stretch: 80%; text-decoration: none; }
  nav { display: flex; gap: 28px; font-size: 0.9375rem; }
  nav a { text-decoration: none; color: var(--ink-soft); transition: color 0.3s; }
  nav a:hover { color: var(--ink); }
  @media (max-width: 720px) { nav a:not(:last-child) { display: none; } }
</style>
