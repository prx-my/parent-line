---
import { roomActors, roomInputs, roomScenes } from "../content";
---
<section id="room">
  <div class="wrap">
    <div class="head">
      <h2 class="h2">One room on Switch</h2>
      <p class="lead">Services post alarms into the family's Telegram group. Switch delivers each one to the agents and people who act on it, and every reply lands in the same history.</p>
    </div>

    <div class="flow after-head" data-flow data-scenes={JSON.stringify(roomScenes)}>
      <svg class="wires" data-wires aria-hidden="true"></svg>

      <div class="col ins">
        <p class="meta col-label">Raise alarms</p>
        {roomInputs.map((n) => (
          <div class:list={["node", { optional: n.optional }]} data-node={n.key} data-side="in" tabindex="0">
            <b>{n.name}</b>
            <span class="meta">{n.kind}</span>
            <code>{n.call}</code>
            <span class="port" data-port aria-hidden="true"></span>
          </div>
        ))}
      </div>

      <div class="room" data-room-box>
        <div class="room-head">
          <b>The family room</b>
          <span class="meta">Telegram group, on Switch</span>
        </div>
        <ol class="log" data-log aria-label="The room's history">
          {roomScenes[0].map((l) => (
            <li class:list={{ alarm: l.alarm }}><b>{l.who}</b><span>{l.text}</span></li>
          ))}
        </ol>
      </div>

      <div class="col outs">
        <p class="meta col-label">Act on them</p>
        {roomActors.map((n) => (
          <div class="node" data-node={n.key} data-side="out" tabindex="0">
            <b>{n.name}</b>
            <span class="meta">{n.kind}</span>
            <code>{n.call}</code>
            <span class="port" data-port aria-hidden="true"></span>
          </div>
        ))}
      </div>
    </div>

    <p class="meta legend">
      <span><i class="key alarm-key"></i>an alarm coming in</span>
      <span><i class="key"></i>Switch delivering, and a reply</span>
      <span><i class="key dash"></i>optional, waiting on a Switch pull request</span>
    </p>
  </div>
</section>

<style>
  .head .lead { max-width: 40rem; }

  .flow { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); align-items: center; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .col { position: relative; z-index: 1; display: grid; gap: 30px; }
  .ins { grid-column: 1 / span 3; justify-items: end; text-align: right; }
  .outs { grid-column: 10 / span 3; justify-items: start; gap: 56px; }
  .col-label { margin-bottom: -6px; }

  .node { position: relative; display: grid; gap: 1px; outline: none; cursor: default; }
  .node b { font-size: var(--fs-h4); font-stretch: 85%; font-weight: 600; line-height: 1.15; }
  .node code { font-size: var(--fs-meta); color: var(--ink-soft); }
  .node:focus-visible { outline: 2px solid var(--ink); outline-offset: 6px; }
  .node.optional b, .node.optional code { color: var(--ink-soft); }
  /* The port is where the node's wire starts */
  .port { position: absolute; top: 0.62em; width: 7px; height: 7px; background: var(--ink); }
  .ins .port { right: -19px; }
  .outs .port { left: -19px; }
  .optional .port { background: var(--paper); border: 1.5px solid var(--ink-soft); }

  .room { grid-column: 5 / span 4; position: relative; z-index: 1; background: var(--paper); border: 1.5px solid var(--ink); min-height: 21rem; display: flex; flex-direction: column; }
  .room-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px; padding: 14px 18px; border-bottom: 1px solid var(--rule-strong); }
  .room-head b { font-size: var(--fs-h4); font-stretch: 85%; font-weight: 640; white-space: nowrap; }
  .log { list-style: none; margin: 0; padding: 6px 18px 14px; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
  .log :global(li) { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 12px; padding-block: 9px; border-bottom: 1px solid var(--rule); font-size: var(--fs-small); line-height: 1.4; }
  .log :global(li:last-child) { border-bottom: 0; }
  .log :global(li b) { font-weight: 600; }
  .log :global(li.alarm span) { color: var(--stamp); font-weight: 500; }

  .wires :global(path) { fill: none; stroke: var(--rule-strong); stroke-width: 1.25; }
  .wires :global(path.dash) { stroke-dasharray: 4 5; }
  .wires :global(path.lit) { stroke: var(--ink); stroke-width: 2; }
  .wires :global(rect) { fill: var(--ink); }
  .wires :global(rect.alarm) { fill: var(--stamp); }

  .legend { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 40px; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .key { display: inline-block; width: 7px; height: 7px; background: var(--ink); }
  .alarm-key { background: var(--stamp); }
  .key.dash { width: 18px; height: 0; border-top: 1.5px dashed var(--ink-soft); background: none; }

  @media (max-width: 900px) {
    .flow { grid-template-columns: minmax(0, 1fr); row-gap: 32px; }
    .wires { display: none; }
    .ins, .outs, .room { grid-column: 1 / -1; }
    .ins, .outs { justify-items: start; text-align: left; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
    .col-label { grid-column: 1 / -1; }
    .port { display: none; }
    .room { min-height: 0; }
  }
  @media (max-width: 520px) {
    .log :global(li) { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
</style>
