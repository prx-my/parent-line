---
const columns = [
  { title: "It sees", cls: "c-l", items: ["Bank SMS, nothing else", "Alarms, never everyday spending", "A ride, only when someone starts one", "No OTPs, PINs or passwords, ever"] },
  { title: "It can't", cls: "c-r", items: ["Stop a transfer. Only the bank can", "See cash or gift-card scams", "Alarm if Mom's phone is off", "Track where a rider is"] },
];
---
<section id="trust">
  <div class="wrap">
    <div class="head">
      <h2 class="h2">What it sees, what it can't</h2>
    </div>
    <div class="grid after-head">
      {columns.map((c) => (
        <div class={c.cls}>
          <h3 class="h3" data-reveal>{c.title}</h3>
          <ul data-stagger>
            {c.items.map((item) => <li class="h4">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  ul { list-style: none; padding: 0; margin: 28px 0 0; border-top: 1px solid var(--rule-strong); }
  li { padding-block: 18px; border-bottom: 1px solid var(--rule); font-weight: 500; }
</style>
