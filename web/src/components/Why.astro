---
const lanes = [
  { title: "The bank's check", tone: "bad", nodes: ["Bank calls Mom", "Scammer coaches her", "\"Yes, it's me\"", "More money leaves"] },
  { title: "Parent Line", tone: "good", nodes: ["Bank SMS", "Bank watch", "Family group", "Riya calls Mom"] },
];
const stats = [
  { n: "21,900+", count: 21900, pre: "", suf: "+", text: "complaints, Jan to Aug 2026", src: "Hindustan Times", href: "https://www.hindustantimes.com/india-news/21900-digital-arrest-complaints-registered-till-sept-mha-to-sc-101792697131006.html" },
  { n: "₹647 cr+", count: 647, pre: "₹", suf: " cr+", text: "involved in those complaints", src: "Hindustan Times", href: "https://www.hindustantimes.com/india-news/21900-digital-arrest-complaints-registered-till-sept-mha-to-sc-101792697131006.html" },
  { n: "₹60 lakh", count: 60, pre: "₹", suf: " lakh", text: "saved when a daughter stepped in", src: "Amar Ujala", href: "https://www.amarujala.com/lucknow/up-digital-arrest-daughter-saves-86-year-old-father-from-being-duped-2026-04-22" },
];
---
<section id="why">
  <div class="wrap">
    <p class="statement words" data-words>The bank calls Mom to confirm. The scammer, still on video, tells her what to say. Parent Line asks the family instead.</p>

    <div class="lanes after-head">
      {lanes.map((lane) => (
        <div class="lane" data-lane>
          <h3 class="h4 lane-head">{lane.title}</h3>
          <div class="track grid">
            <span class="rule" data-lane-rule aria-hidden="true"></span>
            <span class="pulse" data-lane-pulse aria-hidden="true"></span>
            {lane.nodes.map((n, i) => (
              <div class:list={["node c-3", { end: i === lane.nodes.length - 1, [lane.tone]: i === lane.nodes.length - 1 }]} data-lane-node>
                {i === lane.nodes.length - 1 ? (
                  lane.tone === "bad" ? (
                    <svg class="endmark" viewBox="0 0 28 40" aria-hidden="true" data-drip>
                      <rect class="stamp-fill" x="7" y="0" width="14" height="14" />
                      <rect class="stamp-fill drop" x="10" y="4" width="8" height="8" />
                      <rect class="stamp-fill drop" x="10" y="4" width="8" height="8" />
                      <rect class="stamp-fill drop" x="10" y="4" width="8" height="8" />
                    </svg>
                  ) : (
                    <svg class="endmark" viewBox="-20 -20 40 40" aria-hidden="true" data-rings>
                      <circle class="ink-line ring" r="7" />
                      <circle class="ink-line ring" r="7" />
                      <circle class="ink-line ring" r="7" />
                      <rect class="ink-fill" x="-7" y="-7" width="14" height="14" />
                    </svg>
                  )
                ) : (
                  <span class="tick" aria-hidden="true"></span>
                )}
                <span class="label">{n}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="grid after-head">
      {stats.map((s) => (
        <div class="stat c-4" data-reveal>
          <div class="num" data-count={s.count} data-prefix={s.pre} data-suffix={s.suf}>{s.n}</div>
          <p class="soft">{s.text}</p>
          <p class="meta"><a href={s.href}>{s.src}</a></p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .words { max-width: 20ch; }

  .lanes { display: grid; gap: var(--sp-block); }
  .lane-head { margin-bottom: 28px; }
  .track { position: relative; }
  .rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--ink); transform-origin: left; }
  .pulse { position: absolute; left: 0; top: -3px; width: 7px; height: 7px; background: var(--ink); opacity: 0; }
  .node { position: relative; padding-top: 30px; padding-right: 12px; line-height: 1.35; }
  .tick { position: absolute; left: 0; top: 0; width: 1px; height: 14px; background: var(--ink); }
  .endmark { position: absolute; left: -14px; top: -7px; width: 28px; }
  [data-rings] { left: -20px; top: -20px; width: 40px; }
  .bad .label { color: var(--stamp); font-weight: 600; }
  .good .label { font-weight: 600; }
  @media (max-width: 900px) {
    .track { row-gap: 22px; padding-left: 30px; }
    .node { grid-column: 1 / -1; padding-top: 0; }
    .rule { left: 0; right: auto; bottom: 0; width: 1px; height: auto; transform-origin: top; }
    .pulse { display: none; }
    .tick { left: -30px; top: 0.7em; width: 14px; height: 1px; }
    .endmark { left: -44px; top: 0; }
    [data-rings] { left: -50px; top: -8px; }
  }

  .stat { border-top: 1px solid var(--rule-strong); padding-top: 24px; }
  .stat .num { white-space: nowrap; }
  .stat p { margin-top: 14px; }
  .stat .meta { margin-top: 6px; }
</style>
