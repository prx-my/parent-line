---
const lanes = [
  {
    title: "The bank's check", sub: "asks the victim",
    nodes: ["Bank calls to confirm", "Mom answers, scammer still on video", "\"Yes, it's me\""],
    end: { text: "Then an FD broken early, then a loan", tone: "bad" },
  },
  {
    title: "Parent Line", sub: "asks the family",
    nodes: ["Bank SMS", "Bank watch", "Family group"],
    end: { text: "Riya calls Mom, and the ringing call breaks the scam's hold", tone: "good" },
  },
];
const stats = [
  { n: "21,900+", count: 21900, pre: "", suf: "+", text: "digital-arrest complaints from January to August 2026.", src: "MHA to the Supreme Court, via Hindustan Times", href: "https://www.hindustantimes.com/india-news/21900-digital-arrest-complaints-registered-till-sept-mha-to-sc-101792697131006.html" },
  { n: "₹647 cr+", count: 647, pre: "₹", suf: " cr+", text: "involved in those complaints, in eight months.", src: "Hindustan Times, 23 Oct 2026", href: "https://www.hindustantimes.com/india-news/21900-digital-arrest-complaints-registered-till-sept-mha-to-sc-101792697131006.html" },
  { n: "Hours, days", text: "is how long victims are kept on video calls, told not to speak to anyone else.", src: "Indian Express, 30 Oct 2026", href: "https://indianexpress.com/article/explained/digital-arrest-scams-supreme-court-rbi-bank-liability-explained-10943089/" },
];
const stories = [
  { amt: "₹60 lakh saved", text: "A daughter in Lucknow stopped the scam on her 86-year-old father.", src: "Amar Ujala", href: "https://www.amarujala.com/lucknow/up-digital-arrest-daughter-saves-86-year-old-father-from-being-duped-2026-04-22" },
  { amt: "₹41 lakh kept", text: "A daughter in Rajkot stopped more money leaving her parents' account.", src: "India Today", href: "https://www.indiatoday.in/cities/other-cities/story/digital-arrest-scam-rajkot-elderly-couple-duped-rs-55-5-lakh-fake-mumbai-crime-branch-officers-2981908-2026-08-28" },
  { amt: "A 10-hour call ended", text: "An 8-year-old in Bareilly ended the scam call on his parents.", src: "India Today", href: "https://www.indiatoday.in/india/story/digital-arrest-cyber-scam-bareilly-8-year-old-boy-saves-parents-2894121-2026-04-10" },
];
---
<section id="why">
  <div class="wrap">
    <p class="statement" data-words>Banks call to confirm a large transfer. In a digital arrest, that call reaches the one person the scammer controls, who has been told exactly what to say. Parent Line asks someone else.</p>

    <div class="lanes">
      {lanes.map((lane) => (
        <div class="lane" data-lane>
          <div class="label"><h3>{lane.title}</h3><p>{lane.sub}</p></div>
          <div class="track">
            <span class="rule" data-lane-rule aria-hidden="true"></span>
            <ol>
              {lane.nodes.map((n) => <li data-lane-node>{n}</li>)}
              <li data-lane-node class={lane.end.tone}>{lane.end.text}</li>
            </ol>
          </div>
        </div>
      ))}
    </div>

    <div class="stats">
      {stats.map((s) => (
        <div class="stat" data-reveal>
          <div class="n" data-count={s.count} data-prefix={s.pre} data-suffix={s.suf}>{s.n}</div>
          <p>{s.text}</p>
          <p class="src"><a href={s.href}>{s.src}</a></p>
        </div>
      ))}
    </div>

    <ul class="stories" data-stagger>
      {stories.map((s) => (
        <li><b>{s.amt}</b>{s.text} <a href={s.href}>{s.src}</a></li>
      ))}
    </ul>
    <p class="note" data-reveal>The NHRC recommends "trusted-person authentication" alerts for the elderly (<a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2270875&lang=1&reg=3">PIB, 9 Jun 2026</a>). The three cases above are single stories; we found no study of how often family help stops these scams.</p>
  </div>
</section>

<style>
  #why { border-top: 1px solid var(--rule); }
  .statement { font-size: clamp(2rem, 4.4vw, 3.8rem); line-height: 1.06; font-stretch: 80%; font-weight: 520; letter-spacing: -0.008em; max-width: 21ch; }

  .lanes { display: grid; gap: 64px; margin-top: clamp(80px, 10vw, 136px); }
  .lane { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: 24px; }
  .label h3 { font-size: 1.5rem; font-stretch: 85%; line-height: 1.1; }
  .label p { font: 400 0.8125rem/1.6 var(--mono); color: var(--ink-soft); margin-top: 4px; }
  .track { position: relative; }
  .rule { position: absolute; left: 0; right: 0; top: 6px; height: 1px; background: var(--ink); transform-origin: left; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  li { position: relative; padding-top: 30px; font-size: 1.0625rem; line-height: 1.35; }
  li::before { content: ""; position: absolute; left: 0; top: 0; width: 1px; height: 13px; background: var(--ink); }
  li.bad { color: var(--stamp); font-weight: 500; }
  li.bad::before { background: var(--stamp); width: 13px; height: 13px; left: -6px; }
  li.good { font-weight: 600; }
  li.good::before { width: 13px; height: 13px; left: -6px; }
  @media (max-width: 860px) {
    .lane { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .rule { left: 6px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; transform-origin: top; }
    ol { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    li { padding-top: 0; padding-left: 30px; }
    li::before { left: 6px; top: 0.6em; width: 13px; height: 1px; }
    li.bad::before, li.good::before { left: 0; top: 0.35em; width: 13px; height: 13px; }
  }

  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: clamp(96px, 12vw, 160px); }
  .stat { border-top: 1px solid var(--rule-strong); padding-top: 24px; }
  .n { font-size: clamp(3.2rem, 7.2vw, 6.4rem); line-height: 0.9; font-stretch: 75%; font-weight: 620; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .stat p { margin-top: 18px; color: var(--ink-soft); font-size: 1rem; max-width: 22rem; }
  .stat .src { margin-top: 10px; font: 400 0.75rem/1.5 var(--mono); }
  @media (max-width: 860px) { .stats { grid-template-columns: minmax(0, 1fr); gap: 48px; } }

  .stories { list-style: none; margin: clamp(72px, 9vw, 112px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .stories li { padding: 20px 0 0; border-top: 1px solid var(--rule); color: var(--ink-soft); font-size: 1rem; }
  .stories li::before { display: none; }
  .stories b { display: block; color: var(--ink); font-weight: 620; font-size: 1.75rem; font-stretch: 80%; line-height: 1.1; margin-bottom: 8px; }
  @media (max-width: 860px) { .stories { grid-template-columns: minmax(0, 1fr); } .stories li { padding-left: 0; } }
</style>
