---
const lanes = [
  {
    title: "The bank's check", sub: "asks the victim", tone: "bad",
    nodes: ["Bank calls to confirm", "Mom answers, scammer still on video", "\"Yes, it's me\"", "Then an FD broken early, then a loan"],
  },
  {
    title: "Parent Line", sub: "asks the family", tone: "good",
    nodes: ["Bank SMS", "Bank watch", "Family group", "Riya calls Mom, and the ringing call breaks the scam's hold"],
  },
];
const stats = [
  { n: "21,900+", count: 21900, pre: "", suf: "+", text: "digital-arrest complaints from January to August 2026.", src: "MHA to the Supreme Court, via Hindustan Times", href: "https://www.hindustantimes.com/india-news/21900-digital-arrest-complaints-registered-till-sept-mha-to-sc-101792697131006.html" },
  { n: "₹647 cr+", count: 647, pre: "₹", suf: " cr+", text: "involved in those complaints, in eight months.", src: "Hindustan Times, 23 Oct 2026", href: "https://www.hindustantimes.com/india-news/21900-digital-arrest-complaints-registered-till-sept-mha-to-sc-101792697131006.html" },
  { n: "Hours, days", text: "is how long victims are kept on video calls, told not to speak to anyone else.", src: "Indian Express, 30 Oct 2026", href: "https://indianexpress.com/article/explained/digital-arrest-scams-supreme-court-rbi-bank-liability-explained-10943089/" },
];
const stories = [
  { amt: "₹60 lakh saved", text: "A daughter in Lucknow stopped the scam on her 86-year-old father.", src: "Amar Ujala", href: "https://www.amarujala.com/lucknow/up-digital-arrest-daughter-saves-86-year-old-father-from-being-duped-2026-04-22" },
  { amt: "₹41 lakh kept", text: "A daughter in Rajkot stopped more money leaving her parents' account.", src: "India Today", href: "https://www.indiatoday.in/cities/other-cities/story/digital-arrest-scam-rajkot-elderly-couple-duped-rs-55-5-lakh-fake-mumbai-crime-branch-officers-2981908-2026-08-28" },
  { amt: "A 10-hour call ended", text: "An 8-year-old in Bareilly ended the scam call on his parents.", src: "India Today", href: "https://www.indiatoday.in/india/story/digital-arrest-cyber-scam-bareilly-8-year-old-boy-saves-parents-2894121-2026-04-10" },
];
---
<section id="why">
  <div class="wrap">
    <div class="grid">
      <p class="statement c-full words" data-words>Banks call to confirm a large transfer. In a digital arrest, that call reaches the one person the scammer controls, who has been told exactly what to say. Parent Line asks someone else.</p>
    </div>

    <div class="lanes after-head">
      {lanes.map((lane) => (
        <div class="lane" data-lane>
          <div class="lane-head"><h3 class="h4">{lane.title}</h3><span class="meta">{lane.sub}</span></div>
          <div class="track grid">
            <span class="rule" data-lane-rule aria-hidden="true"></span>
            <span class="pulse" data-lane-pulse aria-hidden="true"></span>
            {lane.nodes.map((n, i) => (
              <div class:list={["node c-3", { end: i === lane.nodes.length - 1, [lane.tone]: i === lane.nodes.length - 1 }]} data-lane-node>
                {i === lane.nodes.length - 1 ? (
                  lane.tone === "bad" ? (
                    <svg class="endmark" viewBox="0 0 28 40" aria-hidden="true" data-drip>
                      <rect class="stamp-fill" x="7" y="0" width="14" height="14" />
                      <rect class="stamp-fill drop" x="10" y="4" width="8" height="8" />
                      <rect class="stamp-fill drop" x="10" y="4" width="8" height="8" />
                      <rect class="stamp-fill drop" x="10" y="4" width="8" height="8" />
                    </svg>
                  ) : (
                    <svg class="endmark" viewBox="-20 -20 40 40" aria-hidden="true" data-rings>
                      <circle class="ink-line ring" r="7" />
                      <circle class="ink-line ring" r="7" />
                      <circle class="ink-line ring" r="7" />
                      <rect class="ink-fill" x="-7" y="-7" width="14" height="14" />
                    </svg>
                  )
                ) : (
                  <span class="tick" aria-hidden="true"></span>
                )}
                <span class="label">{n}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="grid after-head">
      {stats.map((s) => (
        <div class="stat c-4" data-reveal>
          <div class="num" data-count={s.count} data-prefix={s.pre} data-suffix={s.suf}>{s.n}</div>
          <p class="soft measure">{s.text}</p>
          <p class="meta"><a href={s.href}>{s.src}</a></p>
        </div>
      ))}
    </div>

    <ul class="grid stories after-block" data-stagger>
      {stories.map((s) => (
        <li class="c-4"><b class="h4">{s.amt}</b><span class="small soft">{s.text} <a href={s.href}>{s.src}</a></span></li>
      ))}
    </ul>
    <p class="note" data-reveal>The NHRC recommends "trusted-person authentication" alerts for the elderly (<a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2270875&lang=1&reg=3">PIB, 9 Jun 2026</a>). The three cases above are single stories; we found no study of how often family help stops these scams.</p>
  </div>
</section>

<style>
  .words { max-width: 22ch; }

  .lanes { display: grid; gap: var(--sp-block); }
  .lane-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 28px; }
  .track { position: relative; }
  .rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--ink); transform-origin: left; }
  .pulse { position: absolute; left: 0; top: -3px; width: 7px; height: 7px; background: var(--ink); opacity: 0; }
  .node { position: relative; padding-top: 30px; padding-right: 12px; line-height: 1.35; }
  .tick { position: absolute; left: 0; top: 0; width: 1px; height: 14px; background: var(--ink); }
  .endmark { position: absolute; left: -14px; top: -7px; width: 28px; }
  [data-rings] { left: -20px; top: -20px; width: 40px; }
  .bad .label { color: var(--stamp); font-weight: 600; }
  .good .label { font-weight: 600; }
  @media (max-width: 900px) {
    .track { row-gap: 22px; padding-left: 30px; }
    .node { grid-column: 1 / -1; padding-top: 0; }
    .rule { left: 0; right: auto; bottom: 0; width: 1px; height: auto; transform-origin: top; }
    .pulse { display: none; }
    .tick { left: -30px; top: 0.7em; width: 14px; height: 1px; }
    .endmark { left: -44px; top: 0; }
    [data-rings] { left: -50px; top: -8px; }
  }

  .stat .num { white-space: nowrap; }
  .stat p { margin-top: 16px; }
  .stat .meta { margin-top: 10px; }
  .stat, .stories li { border-top: 1px solid var(--rule-strong); padding-top: 24px; }
  .stories { list-style: none; padding: 0; margin-bottom: 0; row-gap: 40px; }
  .stories li { display: grid; gap: 8px; border-top-color: var(--rule); padding-top: 20px; }
</style>
