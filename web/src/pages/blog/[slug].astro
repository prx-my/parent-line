---
import Post from "../../layouts/Post.astro";
import { posts, type Post as PostData } from "../../posts";

export function getStaticPaths() {
  return posts.filter((post) => !post.url).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: PostData };
const { Content } = post;
---
<Post post={post}><Content /></Post>
