---
import Site from "../../layouts/Site.astro";
import { posts } from "../../posts";
---
<Site title="Blog" description="Notes from building Parent Line: why it exists, how it works on Switch, and what's next." type="website">
  <section class="blog">
    <div class="grid top">
      <h1 class="h2 c-l">Blog</h1>
      <div class="c-r intro">
        <p class="lead">Notes from building Parent Line: why it exists, how it's built on Switch, and what broke on the way.</p>
        <p class="meta">{posts.length} posts</p>
      </div>
    </div>

    <ol class="list after-head">
      {posts.map((p) => (
        <li>
          <a class="grid row" href={p.url ?? `/blog/${p.slug}/`}>
            <div class="c-l6 lhs">
              <p class="meta"><time datetime={p.iso}>{p.published}</time> · {p.minutes} min read{p.url && " · on DEV"}</p>
              <h2 class="h3">{p.title}</h2>
            </div>
            <div class="c-r rhs">
              <p class="soft">{p.description}</p>
              <span class="textlink">{p.url ? "Read on DEV" : "Read the post"} <span aria-hidden="true">{p.url ? "↗" : "→"}</span></span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Site>

<style>
  .blog { border-top: 0; }
  .top { align-items: end; }
  .intro { display: grid; gap: 12px; }

  .list { list-style: none; margin-bottom: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .list li { border-bottom: 1px solid var(--rule); }
  .row { padding-block: var(--sp-head); text-decoration: none; row-gap: 20px; }
  .lhs { display: grid; gap: 16px; align-content: start; }
  /* Line the description up with the title, not the date above it */
  .rhs { display: grid; gap: 24px; align-content: start; justify-items: start; padding-top: calc(var(--fs-meta) * 1.5 + 16px); }
  .rhs p { max-width: 34rem; }
  .row:hover .textlink { border-color: var(--ink); }
  .row:hover .textlink span { transform: translate(2px, -2px); }
  @media (max-width: 900px) {
    .rhs { padding-top: 0; }
  }
</style>
