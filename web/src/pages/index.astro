---
import "@fontsource-variable/anek-latin/standard.css";
import "@fontsource-variable/anek-devanagari/standard.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Why from "../components/Why.astro";
import Alarm from "../components/Alarm.astro";
import Room from "../components/Room.astro";
import Ways from "../components/Ways.astro";
import Deadline from "../components/Deadline.astro";
import Trust from "../components/Trust.astro";
import Footer from "../components/Footer.astro";

const description = "When an older parent's bank SMS looks like a digital-arrest scam, Parent Line raises an alarm in the family's group chat, where the family and two AI agents deal with it together. Built on Switch.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Parent Line</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Parent Line" />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#E2E9EF" />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <Why />
      <Alarm />
      <Room />
      <Ways />
      <Deadline />
      <Trust />
    </main>
    <Footer />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
